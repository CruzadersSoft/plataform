<%= render layout: "church/shared/shell", locals: { active: :notifications } do %>
  <header class="page-header entity-header">
    <div>
      <p class="page-eyebrow"><%= link_to "Notificações", notifications_path %></p>
      <h1 class="page-title"><%= @notification.title %></h1>
    </div>
  </header>

  <section class="card entity-card">
    <div class="card-body">
      <div class="d-flex gap-2 mb-3">
        <span class="badge text-bg-secondary"><%= @notification.notification_type.humanize %></span>
        <span class="badge text-bg-success">Lida</span>
      </div>

      <% if @notification.body.present? %>
        <p class="mb-3"><%= simple_format(@notification.body) %></p>
      <% end %>

      <p class="entity-muted mb-0">
        Recebida em <%= @notification.created_at.strftime("%d/%m/%Y") %>
        <% if @notification.read_at.present? %>
          · Lida em <%= @notification.read_at.strftime("%d/%m/%Y") %>
        <% end %>
      </p>
    </div>
  </section>
<% end %>
