<%= render layout: "church/shared/shell", locals: { active: :tasks } do %>
  <header class="page-header entity-header">
    <div>
      <p class="page-eyebrow"><%= link_to "Tarefas", tasks_path %></p>
      <h1 class="page-title"><%= @task.title %></h1>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <% if policy(@task).update? %>
        <%= link_to "Editar", edit_task_path(@task), class: "btn btn-outline-secondary" %>
      <% end %>
      <% if policy(@task).destroy? %>
        <%= button_to "Cancelar tarefa", task_path(@task), method: :delete,
            class: "btn btn-outline-danger",
            data: { turbo_confirm: "Tem certeza que deseja cancelar esta tarefa?" } %>
      <% end %>
    </div>
  </header>

  <section class="card entity-card">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3">Departamento</dt>
        <dd class="col-sm-9"><%= @task.department.name %></dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
          <% status_class = @task.done? ? "text-bg-success" : (@task.cancelled? ? "text-bg-danger" : (@task.in_progress? ? "text-bg-primary" : "text-bg-secondary")) %>
          <span class="badge <%= status_class %>"><%= @task.status.humanize %></span>
        </dd>

        <dt class="col-sm-3">Prioridade</dt>
        <dd class="col-sm-9">
          <% priority_class = @task.high? ? "text-bg-danger" : (@task.medium? ? "text-bg-warning" : "text-bg-secondary") %>
          <span class="badge <%= priority_class %>"><%= @task.priority.humanize %></span>
        </dd>

        <dt class="col-sm-3">Prazo</dt>
        <dd class="col-sm-9"><%= @task.due_at&.strftime("%d/%m/%Y") || "Não definido" %></dd>

        <dt class="col-sm-3">Atribuído a</dt>
        <dd class="col-sm-9"><%= @task.assigned_user&.display_name || "Não atribuído" %></dd>

        <% if @task.description.present? %>
          <dt class="col-sm-3">Descrição</dt>
          <dd class="col-sm-9"><%= @task.description %></dd>
        <% end %>
      </dl>
    </div>
  </section>
<% end %>
