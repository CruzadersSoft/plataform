<%= render layout: "church/shared/shell", locals: { active: :events } do %>
  <header class="page-header entity-header">
    <div>
      <p class="page-eyebrow"><%= link_to "Eventos", events_path %> / <%= @event.title %></p>
      <h1 class="page-title"><%= @event.title %></h1>
      <p class="page-description">
        <%= @event.event_type.humanize %> &middot;
        <%= @event.starts_at.strftime("%d/%m/%Y %H:%M") %> – <%= @event.ends_at.strftime("%H:%M") %>
        <% if @event.location.present? %> &middot; <%= @event.location %><% end %>
      </p>
    </div>
    <div class="d-flex gap-2">
      <% badge_class = @event.published? ? "text-bg-success" : (@event.cancelled? ? "text-bg-danger" : "text-bg-secondary") %>
      <span class="badge <%= badge_class %>"><%= @event.status.humanize %></span>
      <% if policy(@event).publish? && !@event.published? && !@event.cancelled? %>
        <%= button_to "Publicar", publish_event_path(@event), method: :patch, class: "btn btn-sm btn-success" %>
      <% end %>
      <% if policy(@event).update? %>
        <%= link_to "Editar", edit_event_path(@event), class: "btn btn-sm btn-outline-primary" %>
      <% end %>
    </div>
  </header>

  <div class="row g-3">
    <div class="col-12">
      <section class="card entity-card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h2 class="card-title h6 mb-0">Convocações</h2>
          <% if policy(@event).update? %>
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#new-assignment-form">Convocar voluntários</button>
          <% end %>
        </div>

        <% if policy(@event).update? %>
          <div class="collapse p-3 border-bottom" id="new-assignment-form">
            <%= form_with url: event_assignments_path(@event), method: :post, scope: :assignment do |f| %>
              <div class="mb-2">
                <label class="form-label" for="assignment_user_ids">Voluntários</label>
                <select name="assignment[user_ids][]" id="assignment_user_ids" multiple class="form-select">
                  <% @available_memberships.each do |membership| %>
                    <option value="<%= membership.user_id %>"><%= membership.user.display_name %></option>
                  <% end %>
                </select>
              </div>
              <%= f.submit "Convocar selecionados", class: "btn btn-sm btn-primary" %>
            <% end %>
          </div>
        <% end %>

        <% if @assignments.any? %>
          <ul class="list-group list-group-flush">
            <% @assignments.each do |a| %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <span class="fw-semibold"><%= a.user.display_name %></span>
                  <% unless a.event_requirement.role_name == EventRequirement::DEFAULT_INVITATION_ROLE %>
                    <div class="entity-muted"><%= a.event_requirement.role_name %></div>
                  <% end %>
                </div>
                <div class="assignment-response-actions d-flex flex-wrap gap-1 align-items-center">
                  <% badge_class = a.confirmed? ? "text-bg-success" : (a.declined? ? "text-bg-danger" : "text-bg-warning") %>
                  <span class="badge <%= badge_class %>"><%= a.status.humanize %></span>
                  <% if policy(a).destroy? %>
                    <%= button_to "Remover", event_assignment_path(@event, a), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Remover esta convocação?" } %>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="p-3 entity-muted">Nenhuma convocação ainda.</p>
        <% end %>
      </section>
    </div>
  </div>
<% end %>
