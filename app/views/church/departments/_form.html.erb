<%= render "shared/auth_errors", resource: department %>

<section class="card entity-card">
  <div class="card-body">
    <%= form_with model: department, local: true do |form| %>
      <div class="row g-3">
        <div class="col-md-6">
          <%= form.label :name, "Nome", class: "form-label" %>
          <%= form.text_field :name, class: "form-control", required: true %>
        </div>

        <div class="col-md-6">
          <%= form.label :color, "Cor", class: "form-label" %>
          <%= form.text_field :color, class: "form-control", placeholder: "#1f6feb" %>
        </div>

        <div class="col-12">
          <%= form.label :description, "Descricao", class: "form-label" %>
          <%= form.text_area :description, class: "form-control", rows: 4 %>
        </div>

        <div class="col-12">
          <div class="form-check">
            <%= form.check_box :active, class: "form-check-input" %>
            <%= form.label :active, "Departamento ativo", class: "form-check-label" %>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2 mt-4">
        <%= form.submit "Salvar", class: "btn btn-primary" %>
        <%= link_to "Cancelar", department.persisted? ? department_path(department) : departments_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</section>
