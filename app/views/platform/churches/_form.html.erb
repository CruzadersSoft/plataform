<%= render "shared/flash" %>
<%= render "shared/auth_errors", resource: church %>

<section class="card">
  <div class="card-body">
    <%= form_with model: [:platform, church], local: true do |form| %>
      <div class="row g-3">
        <div class="col-md-6">
          <%= form.label :name, "Nome", class: "form-label" %>
          <%= form.text_field :name, class: "form-control", required: true %>
        </div>

        <div class="col-md-6">
          <%= form.label :slug, "Slug", class: "form-label" %>
          <%= form.text_field :slug, class: "form-control", required: true %>
        </div>

        <div class="col-md-6">
          <%= form.label :legal_name, "Razao social", class: "form-label" %>
          <%= form.text_field :legal_name, class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= form.label :email, "E-mail", class: "form-label" %>
          <%= form.email_field :email, class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= form.label :phone, "Telefone", class: "form-label" %>
          <%= form.telephone_field :phone, class: "form-control" %>
        </div>

        <div class="col-md-6">
          <%= form.label :timezone, "Fuso horario", class: "form-label" %>
          <%= form.text_field :timezone, class: "form-control", required: true %>
        </div>

        <div class="col-md-6">
          <%= form.label :status, "Status", class: "form-label" %>
          <%= form.select :status, Church.statuses.keys.map { |status| [status.humanize, status] }, {}, class: "form-select" %>
        </div>
      </div>

      <div class="d-flex gap-2 mt-4">
        <%= form.submit "Salvar", class: "btn btn-primary" %>
        <%= link_to "Cancelar", church.persisted? ? platform_church_path(church) : platform_churches_path, class: "btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</section>
