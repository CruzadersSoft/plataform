<% content_for :head do %>
  <%= stylesheet_link_tag "auth" %>
<% end %>

<div class="auth-page">
  <div class="auth-card">

    <div class="auth-brand">
      <div class="auth-brand-mark"></div>
      <span class="auth-brand-name">Plataform GVI</span>
    </div>

    <div class="auth-header">
      <h1 class="auth-title">Recuperar senha</h1>
      <p class="auth-subtitle">Enviaremos um link de redefinição para o seu e‑mail.</p>
    </div>

    <% if flash[:alert] %>
      <div class="auth-flash auth-flash--error"><%= flash[:alert] %></div>
    <% end %>
    <% if flash[:notice] %>
      <div class="auth-flash auth-flash--notice"><%= flash[:notice] %></div>
    <% end %>

    <%= form_with url: passwords_path, html: { class: "auth-form" } do |form| %>
      <div class="auth-field">
        <%= form.label :email_address, "E‑mail", class: "auth-label" %>
        <%= form.email_field :email_address,
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "seu@email.com",
              value: params[:email_address],
              class: "auth-input" %>
      </div>

      <%= form.submit "Enviar instruções", class: "auth-btn" %>
    <% end %>

    <div class="auth-footer">
      <p class="auth-footer-row">
        Lembrou a senha?
        <%= link_to "Voltar ao login", new_session_path, class: "auth-link" %>
      </p>
    </div>

  </div>
</div>
