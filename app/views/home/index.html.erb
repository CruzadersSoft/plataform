<%= render layout: "church/shared/shell", locals: { active: :home } do %>
  <header class="page-header" id="visao-geral">
    <div>
      <p class="page-eyebrow">Painel da igreja</p>
      <h1 class="page-title"><%= @church.name %></h1>
      <p class="page-description">
        Este painel esta conectado ao tenant ativo e sera a base dos modulos operacionais da igreja.
      </p>
    </div>

    <div>
      <span class="badge text-bg-primary rounded-pill" data-testid="current-church-role"><%= @membership.effective_role_label %></span>
    </div>
  </header>

  <section class="card" id="proximos-passos">
    <div class="card-body">
      <h2 class="card-title h5">Dados da igreja</h2>
      <p class="card-text text-secondary">Informacoes basicas do tenant ativo nesta sessao.</p>

      <dl class="row mb-0">
        <dt class="col-sm-3">Slug</dt>
        <dd class="col-sm-9" data-testid="current-church-slug"><%= @church.slug %></dd>

        <dt class="col-sm-3">Fuso horario</dt>
        <dd class="col-sm-9"><%= @church.timezone %></dd>

        <dt class="col-sm-3">Papel</dt>
        <dd class="col-sm-9"><%= @membership.effective_role_label %></dd>
      </dl>

      <% if @invitation_code.present? %>
        <div class="alert alert-success mt-4" role="note">
          <div class="fw-semibold">Codigo para entrar na igreja</div>
          <div class="fs-4 fw-bold mt-1" data-testid="church-invitation-code"><%= @invitation_code.code %></div>
          <div class="text-secondary mt-1">Compartilhe este codigo com quem deve entrar como voluntario.</div>
        </div>
      <% end %>

      <div class="alert alert-primary d-flex align-items-start gap-3 mt-3" role="note">
        <span aria-hidden="true">i</span>
        <div>
          <strong>Dashboard inicial</strong>
          <div class="mt-1 text-secondary">Use os modulos de membros, departamentos, eventos e escalas para operar a igreja.</div>
        </div>
      </div>

      <div class="d-flex flex-wrap gap-2 mt-4">
        <%= link_to "Departamentos", departments_path, class: "btn btn-primary" %>
        <%= link_to "Eventos", events_path, class: "btn btn-outline-primary" %>
        <%= link_to "Minhas convocações", assignments_path, class: "btn btn-outline-primary" %>
        <%= link_to "Indisponibilidades", unavailabilities_path, class: "btn btn-outline-primary" %>
        <% if policy(ChurchMembership).index? %>
          <%= link_to "Membros", members_path, class: "btn btn-outline-primary" %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
