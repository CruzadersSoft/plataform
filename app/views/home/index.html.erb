<div class="app-shell">
  <aside class="app-sidebar" aria-label="Menu principal">
    <div class="app-brand">
      <div class="app-brand-mark" aria-hidden="true">G</div>
      <div>
        <div class="app-brand-name"><%= @church.name %></div>
        <div class="app-brand-subtitle">Painel da igreja</div>
      </div>
    </div>

    <nav class="app-nav">
      <a href="#visao-geral" class="app-nav-link is-active" aria-current="page">
        <span class="app-nav-icon" aria-hidden="true">⌂</span>
        Início
      </a>
      <a href="#proximos-passos" class="app-nav-link">
        <span class="app-nav-icon" aria-hidden="true">?</span>
        Próximos passos
      </a>
    </nav>
  </aside>

  <main class="app-main" id="conteudo-principal">
    <div class="app-topbar">
      <span class="badge text-bg-success rounded-pill"><%= @church.status.humanize %></span>
      <%= button_to "Sair", session_path, method: :delete, class: "btn btn-link text-muted text-decoration-none p-0" %>
    </div>

    <%= render "shared/flash" %>

    <header class="page-header" id="visao-geral">
      <div>
        <p class="page-eyebrow">Painel da igreja</p>
        <h1 class="page-title"><%= @church.name %></h1>
        <p class="page-description">
          Este painel esta conectado ao tenant ativo e sera a base dos modulos operacionais da igreja.
        </p>
      </div>

      <div>
        <span class="badge text-bg-primary rounded-pill" data-testid="current-church-role"><%= @membership.church_role %></span>
      </div>
    </header>

    <section class="card" id="proximos-passos">
      <div class="card-body">
        <h2 class="card-title h5">Dados da igreja</h2>
        <p class="card-text text-secondary">Informacoes basicas do tenant ativo nesta sessao.</p>

        <dl class="row mb-0">
          <dt class="col-sm-3">Slug</dt>
          <dd class="col-sm-9" data-testid="current-church-slug"><%= @church.slug %></dd>

          <dt class="col-sm-3">Fuso horario</dt>
          <dd class="col-sm-9"><%= @church.timezone %></dd>

          <dt class="col-sm-3">Papel</dt>
          <dd class="col-sm-9"><%= @membership.church_role.humanize %></dd>
        </dl>

        <% if @invitation_code.present? %>
          <div class="alert alert-success mt-4" role="note">
            <div class="fw-semibold">Codigo para entrar na igreja</div>
            <div class="fs-4 fw-bold mt-1" data-testid="church-invitation-code"><%= @invitation_code.code %></div>
            <div class="text-secondary mt-1">Compartilhe este codigo com quem deve entrar como voluntario.</div>
          </div>
        <% end %>

        <div class="alert alert-primary d-flex align-items-start gap-3 mt-3" role="note">
          <span aria-hidden="true">ℹ</span>
          <div>
            <strong>Dashboard inicial</strong>
            <div class="mt-1 text-secondary">Os proximos cards devem nascer dos modulos reais: membros, departamentos, eventos e escalas.</div>
          </div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <%= button_to "Sair", session_path, method: :delete, class: "btn btn-outline-secondary" %>
        </div>
      </div>
    </section>
  </main>
</div>

<nav class="app-mobile-nav mobile-only" aria-label="Menu inferior">
  <a href="#visao-geral" class="app-mobile-nav-link is-active" aria-current="page">
    <span class="app-mobile-nav-icon" aria-hidden="true">⌂</span>
    Início
  </a>
  <a href="#proximos-passos" class="app-mobile-nav-link">
    <span class="app-mobile-nav-icon" aria-hidden="true">?</span>
    Próximos
  </a>
</nav>
