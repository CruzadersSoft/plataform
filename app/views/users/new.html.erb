<% content_for :head do %>
  <%= stylesheet_link_tag "auth" %>
<% end %>

<div class="auth-page">
  <div class="auth-card">

    <div class="auth-brand">
      <div class="auth-brand-mark"></div>
      <span class="auth-brand-name">Plataform GVI</span>
    </div>

    <div class="auth-header">
      <h1 class="auth-title">Criar conta</h1>
      <p class="auth-subtitle">Comece agora. É rápido e gratuito.</p>
    </div>

    <%= form_with model: @user, html: { class: "auth-form" } do |form| %>
      <div class="auth-field">
        <%= form.label :email_address, "E‑mail", class: "auth-label" %>
        <%= form.email_field :email_address,
              autofocus: true,
              autocomplete: "username",
              placeholder: "seu@email.com",
              class: "auth-input" %>
      </div>

      <div class="auth-field">
        <%= form.label :password, "Senha", class: "auth-label" %>
        <%= form.password_field :password,
              autocomplete: "new-password",
              placeholder: "••••••••",
              class: "auth-input" %>
      </div>

      <div class="auth-field">
        <%= form.label :password_confirmation, "Confirmar senha", class: "auth-label" %>
        <%= form.password_field :password_confirmation,
              autocomplete: "new-password",
              placeholder: "••••••••",
              class: "auth-input" %>
      </div>

      <%= form.submit "Criar conta", class: "auth-btn" %>
    <% end %>

    <div class="auth-footer">
      <p class="auth-footer-row">
        Já tem conta?
        <%= link_to "Entrar", new_session_path, class: "auth-link" %>
      </p>
    </div>

  </div>
</div>
